# Copy this file to `.env` and fill in real values before launching the HTTP entry point.
# Both the Node process and Docker must be invoked with the explicit
# `--env-file` option; application code does not auto-load this file.

# Required: Infomaniak calendar API token.
# Create at https://manager.infomaniak.com/v3/ng/accounts/token/list
# with the "workspace:calendar user_info" scope.
CALENDAR_TOKEN=

# Optional: HTTP bind address. Default: 127.0.0.1
# Container default is 0.0.0.0; the image sets it.
MCP_HTTP_HOST=127.0.0.1

# Optional: HTTP listen port. Default: 4500. Must be 1..65535.
MCP_HTTP_PORT=4500

# Optional: Comma-separated Host header values accepted by Node.
# Default: loopback hostnames. Non-loopback publication requires an
# authenticated reverse proxy or private-network/firewall boundary.
MCP_HTTP_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# Optional: Comma-separated Origin values accepted when an Origin header
# is present. Default: loopback origins. A missing Origin remains valid
# for non-browser MCP clients.
MCP_HTTP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*,http://[::1]:*